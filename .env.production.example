# Copy to .env.production on the server and fill in. Never commit the real file.

# Your domain (DNS A record -> EC2 Elastic IP). No domain? Use <ip-with-dashes>.sslip.io, e.g. 3-110-45-12.sslip.io
DOMAIN=conflictforge.example.com

# Generate each with: openssl rand -hex 32   (hex keeps them URL-safe for DATABASE_URL)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Same Google OAuth client ID you use locally
GOOGLE_CLIENT_ID=

# Optional but strongly recommended
GITHUB_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GID of the host's "docker" group (getent group docker | cut -d: -f3), lets the backend run sandboxes
DOCKER_GID=999
